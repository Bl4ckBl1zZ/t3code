# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=tunnels.example.com

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Required: Cloudflare account and least-privilege runtime API token.
# Scope the token to Cloudflare Tunnel Edit for the relay account and DNS Edit
# for RELAY_TUNNEL_ZONE_NAME only. This secret is bound to the relay Worker.
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_RUNTIME_API_TOKEN=...

# Required: existing PostgreSQL database
# The database must accept TLS connections. Use a dedicated database and user.
DATABASE_URL=postgresql://relay:password@postgres.example.com:5432/t3coderelay?sslmode=require

# Required: existing Cloudflare Hyperdrive configuration. For a private
# Dokploy database, connect Hyperdrive through a Workers VPC service.
DATABASE_HYPERDRIVE_ID=...

# Optional: CI migrations through a local `cloudflared access tcp` listener.
# DATABASE_MIGRATION_URL=postgresql://relay:password@127.0.0.1:15433/t3coderelay?uselibpqcompat=true&sslmode=require

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Required: Apple Push Notification service
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...
